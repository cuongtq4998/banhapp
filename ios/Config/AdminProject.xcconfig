// Project-wide build settings of the admin app. Machine-specific values (the Apple development team,
// the API address of a real host) live in Local.xcconfig, which is git-ignored (public repository).

// Address of the backend (docs/system/api.md). Debug builds point at a backend started on this Mac
// (docs/engineering/dev-guide.md); "//" starts a comment in an xcconfig file, so the scheme separator
// is written as "/$()/". Release builds have no usable default: set API_BASE_URL in Local.xcconfig.
API_BASE_URL = http:/$()/127.0.0.1:8080
API_BASE_URL[config=Release] = https:/$()/api.example.invalid

#include? "Local.xcconfig"
