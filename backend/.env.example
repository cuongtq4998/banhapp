# Names only; copy to .env for local runs and fill in. Never commit real values.
# Meaning of each variable: docs/system/deployment.md section 3.

# local, staging or production (both commands)
APP_ENV=
# serve only
PORT=
# Application role (limited rights); serve only. Optional when APP_ENV=local.
DATABASE_URL=
# Migration role; only the `migrate` command reads it (with APP_ENV, nothing else).
DATABASE_MIGRATION_URL=
# Optional, default 5
DATABASE_POOL_MAX=
# Optional, default info
LOG_LEVEL=

# UUID of the shop served; required unless APP_ENV=local (without it the catalog answers 503)
SHOP_ID=
# true or false (default false). Set true behind a proxy that sets X-Forwarded-For (the host),
# otherwise every client shares the proxy's address in the rate limiter.
TRUST_PROXY=
# Optional, default 120 (read requests per client address per minute)
RATE_LIMIT_READ_PER_MINUTE=
# Optional, default empty: image_url stays a path on the API host
PUBLIC_ASSET_BASE_URL=

# Read by later slices (documented now so the host can be prepared):
ORDERING_ENABLED=
RATE_LIMIT_ORDER_PER_HOUR=
ORDER_MAX_PER_PHONE_PER_DAY=

# Admin e-mail sign-in (ADR-0022, ADR-0023). Set AUTH_CODE_PEPPER and EMAIL_PROVIDER together;
# with neither set, /v1/auth answers 503 and the rest of the API is unaffected.
# Secret that keys the hash of sign-in codes; at least 32 characters (for example 32 random bytes, base64)
AUTH_CODE_PEPPER=
# console (prints the mail text, local and staging only) or recording (tests); both are refused when
# APP_ENV=production. The live provider arrives with ADR-0023's go-live approval.
EMAIL_PROVIDER=
# Optional, default 80: code requests per UTC day over all addresses, then 429 CODE_REQUEST_LIMIT
EMAIL_MAX_PER_DAY=
# create-owner reads DATABASE_URL, SHOP_ID and APP_ENV:  swift run App create-owner --email <address> [--name <name>]
