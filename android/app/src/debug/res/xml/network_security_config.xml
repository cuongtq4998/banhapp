<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the app reach a backend running on the developer machine through the
     emulator's host alias. Release builds keep cleartext traffic off. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
