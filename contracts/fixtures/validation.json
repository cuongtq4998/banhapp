    { "field": "name", "text": "  Nguyen Van An  ", "valid": true, "reason": "surrounding blanks are trimmed" },
    { "field": "name", "text": "a", "repeat": 100, "valid": true, "reason": "exactly 100" },
    { "field": "name", "text": "a", "repeat": 101, "valid": false, "reason": "101 code points" },
    { "field": "name", "text": "", "valid": false, "reason": "required" },
    { "field": "name", "text": "   ", "valid": false, "reason": "only blanks" },
    { "field": "name", "text": "Nguyen\nVan", "valid": false, "reason": "newline is not allowed in a name" },
    { "field": "name", "text": "Nguyen\u0007Van", "valid": false, "reason": "control character" },
    { "field": "name", "text": "ệ", "repeat": 60, "valid": true, "reason": "60 letters written decomposed (180 code points) count 60 after NFC" },
