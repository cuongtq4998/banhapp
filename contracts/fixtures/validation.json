    { "input": "0712345678", "valid": true, "normalized": "0712345678", "e164": "+84712345678" },
    { "input": "0812345678", "valid": true, "normalized": "0812345678", "e164": "+84812345678" },
    { "input": "0212345678", "valid": false, "normalized": "0212345678", "e164": null, "reason": "second digit 2 is a landline area code" },
    { "input": "0412345678", "valid": false, "normalized": "0412345678", "e164": null, "reason": "second digit 4 is not a mobile prefix" },
    { "input": "0612345678", "valid": false, "normalized": "0612345678", "e164": null, "reason": "second digit 6 is not a mobile prefix" },
    { "input": "0112345678", "valid": false, "normalized": "0112345678", "e164": null, "reason": "second digit 1 is not a mobile prefix" },
    { "input": "091234567", "valid": false, "normalized": "091234567", "e164": null, "reason": "nine digits" },
    { "input": "09123456789", "valid": false, "normalized": "09123456789", "e164": null, "reason": "eleven digits" },
    { "input": "912345678", "valid": false, "normalized": "912345678", "e164": null, "reason": "no leading zero and no country code" },
    { "input": "8412345678", "valid": false, "normalized": "8412345678", "e164": null, "reason": "84 form needs 11 digits" },
    { "input": "+14155550100", "valid": false, "normalized": "+14155550100", "e164": null, "reason": "foreign number" },
    { "input": "09a2345678", "valid": false, "normalized": "09a2345678", "e164": null, "reason": "letter" },
    { "input": "", "valid": false, "normalized": "", "e164": null, "reason": "empty" }
